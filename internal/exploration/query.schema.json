{
  "type": "object",
  "properties": {
    "api_version": {
      "const": "metricspire.io/v1alpha1",
      "type": "string"
    },
    "kind": {
      "const": "AnalysisQuery",
      "type": "string"
    },
    "source": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
    },
    "group_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 16
    },
    "time_range": {
      "type": "object",
      "properties": {
        "dimension": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "start",
        "end",
        "timezone"
      ],
      "additionalProperties": false
    },
    "time_grouping": {
      "type": "object",
      "properties": {
        "dimension": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "granularity": {
          "type": "string",
          "enum": [
            "day",
            "week",
            "month"
          ]
        },
        "week_start": {
          "type": "string",
          "enum": [
            "monday"
          ]
        }
      },
      "required": [
        "dimension",
        "timezone",
        "granularity"
      ],
      "additionalProperties": false
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimension": {
            "type": "string"
          },
          "operator": {
            "type": "string",
            "enum": [
              "eq",
              "in"
            ]
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          }
        },
        "required": [
          "dimension",
          "operator",
          "values"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    },
    "where": {
      "$ref": "#/$defs/expression"
    },
    "measures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measure"
      },
      "maxItems": 32
    },
    "calculations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/calculation"
      },
      "maxItems": 16
    },
    "summarize": {
      "$ref": "#/$defs/summary"
    },
    "order_by": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          }
        },
        "required": [
          "field",
          "direction"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  },
  "required": [
    "api_version",
    "kind",
    "source",
    "time_range",
    "measures",
    "limit"
  ],
  "additionalProperties": false,
  "$defs": {
    "expression": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "ref",
            "literal",
            "add",
            "subtract",
            "multiply",
            "divide",
            "eq",
            "neq",
            "lt",
            "lte",
            "gt",
            "gte",
            "and",
            "or",
            "not",
            "is_null",
            "is_not_null",
            "weekday",
            "case",
            "share"
          ]
        },
        "ref": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "decimal",
            "boolean",
            "date",
            "timestamp"
          ]
        },
        "value": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression"
          },
          "maxItems": 64
        },
        "partition_by": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 16
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": false
    },
    "measure": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "op": {
          "type": "string",
          "enum": [
            "count",
            "count_distinct",
            "sum",
            "avg",
            "min",
            "max"
          ]
        },
        "field": {
          "type": "string"
        },
        "where": {
          "$ref": "#/$defs/expression"
        }
      },
      "required": [
        "name",
        "op"
      ],
      "additionalProperties": false
    },
    "calculation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "expression": {
          "$ref": "#/$defs/expression"
        }
      },
      "required": [
        "name",
        "expression"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "group_by": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 16
        },
        "measures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/measure"
          },
          "maxItems": 32
        },
        "calculations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/calculation"
          },
          "maxItems": 16
        }
      },
      "required": [
        "measures"
      ],
      "additionalProperties": false
    }
  }
}
